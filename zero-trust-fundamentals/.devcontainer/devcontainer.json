{
  "name": "Zero Trust Fundamentals Lab",
  "image": "ghcr.io/srl-labs/containerlab/devcontainer-dind-slim:0.68.0",
  "runArgs": [
    "--privileged",
    "--network=host"
  ],
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "srl-labs.vscode-containerlab",
        "ms-vscode.vscode-yaml",
        "redhat.vscode-yaml",
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "ms-vscode.makefile-tools",
        "ms-python.vscode-pylance",
        "TerrenceBattlehunt.damira-assistant"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.formatting.provider": "black"
      }
    }
  },
  "postCreateCommand": "containerlab version && docker pull ghcr.io/sever-sever/vyos-container@sha256:c79e39ef91ee15a884ebaaa624249bb6ec71eb2b1e27a49287ea3521aebe83c7 && docker pull alpine:3.22 && docker pull mongo:7.0.14 && pip install fastapi uvicorn httpx motor pymongo pyjwt",
  "remoteUser": "vscode"
}
